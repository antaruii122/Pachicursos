# .env.example — Alimenta Tu Fertilidad, plataforma de cursos
#
# Copia este archivo a `.env.local` (Next.js) y completa los valores reales.
# NUNCA subir `.env.local` a git — ya debe estar en .gitignore.
# En producción, estas mismas variables se cargan en Vercel (Project Settings → Environment Variables),
# nunca hardcodeadas en el código.
#
# Cada bloque indica: para qué sirve, dónde se consigue, y en qué Parte del roadmap
# (docs/cursos.md) se necesita. No hace falta juntar todo ahora — solo lo de Parte A.

# ============================================================
# SITIO / DOMINIO — Parte A
# ============================================================

# URL pública del subdominio de cursos (ya definida como definitiva en el plan)
NEXT_PUBLIC_SITE_URL=https://cursos.alimentatufertilidad.com

# ============================================================
# SUPABASE — base de datos + auth — Parte A (cuenta) / Parte B (uso real)
# Dónde se consigue: supabase.com → crear proyecto → Project Settings → API
# ============================================================

# Project URL (pública, empieza con https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (pública, se usa en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA — nunca exponer al cliente, solo se usa en el servidor/API routes)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# VIMEO — hosting de video — Parte A (cuenta, plan Standard+)
# Dónde se consigue: vimeo.com → cuenta con plan Standard o superior →
# developer.vimeo.com/apps → crear una app → generar token con permisos:
# "upload", "edit", "private" (necesarios para subir vía TUS y servir video privado)
# ============================================================

VIMEO_ACCESS_TOKEN=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# ============================================================
# RESEND — email transaccional — Parte A (cuenta) / Parte F (uso real)
# Dónde se consigue: resend.com → API Keys → crear una nueva key
# ============================================================

RESEND_API_KEY=

# Email remitente verificado en Resend (dominio o subdominio verificado con sus registros DNS)
RESEND_FROM_EMAIL=

# Email de Marcela para el aviso interno de "hubo una venta"
NOTIFICACION_VENTA_EMAIL=

# ============================================================
# FLOW.CL — pagos Chile (principal) — Parte A (se inicia el trámite) / Parte F (uso real)
# Dónde se consigue: flow.cl → cuenta de comercio (a nombre de Marcela/titular del negocio,
# requiere RUT + cuenta bancaria) → una vez aprobada: Panel de comercio → API
# ============================================================

FLOW_API_KEY=
FLOW_SECRET_KEY=

# https://sandbox.flow.cl/api para pruebas, https://www.flow.cl/api en producción
FLOW_API_URL=https://sandbox.flow.cl/api

# ============================================================
# STRIPE — pagos internacionales (respaldo) — Parte F
# Dónde se consigue: dashboard.stripe.com → Developers → API keys
# El webhook signing secret se genera recién al registrar el endpoint del webhook (Parte F)
# ============================================================

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# META PIXEL + CONVERSIONS API — marketing/retargeting — Parte G
# Dónde se consigue: business.facebook.com → Events Manager → tu Pixel → Configuración
# ============================================================

NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# ============================================================
# N8N — automatizaciones (boleta electrónica + emails de ciclo de vida) — Parte H
# Dónde se consigue: instancia propia de n8n (cloud o autohospedada) → credenciales de acceso.
# El proveedor de facturación electrónica (SII) todavía no está elegido (ver docs/cursos.md,
# Contexto y Checklist) — se agrega acá cuando se defina, no bloquea las Partes anteriores.
# ============================================================

N8N_WEBHOOK_URL=
